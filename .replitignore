# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Private research drafts; tracked for delivery, never deployed.
/docs/llmdan/
# Generated video exports (restored from App Storage when needed)
artifacts/bekiut-demo/exports/

# Development caches and local tooling; not required by production Node services.
/.cache/
/.pythonlibs/

# Local uploads, research notes, and review captures (not runtime inputs).
/attached_assets/
/documents/
/screenshots/
/docs/

# Archived projects: retained locally, excluded from published images.
/artifacts/bekiut-demo/
/artifacts/research-guide-preview/
/jewish-research-guide/
/artifacts/mockup-sandbox/
/.canvas/
/scripts/.cache/

# Keep node_modules, scripts, patches, talmud-data, public assets and build
# outputs: production builds and/or running services depend on them.

diff --git a/lib/depth.js b/lib/depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..c9ef9bbd13e85794deb363ea2549c4b4f3530b4d
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,26 @@
+'use strict';
+
+// GHSA-vfj7-8cjw-p6xm: recursive AST walkers must not receive unbounded nesting.
+// Keep the limit non-configurable so caller options cannot disable this guard.
+const MAX_DEPTH = 128;
+
+const assertDepth = depth => {
+  if (depth > MAX_DEPTH) {
+    throw new SyntaxError(`Brace pattern exceeds maximum nesting depth (${MAX_DEPTH})`);
+  }
+};
+
+const assertAstDepth = ast => {
+  const pending = [{ node: ast, depth: 0 }];
+  while (pending.length > 0) {
+    const { node, depth } = pending.pop();
+    assertDepth(depth);
+    if (node && Array.isArray(node.nodes)) {
+      for (const child of node.nodes) {
+        pending.push({ node: child, depth: depth + 1 });
+      }
+    }
+  }
+};
+
+module.exports = { assertDepth, assertAstDepth };
